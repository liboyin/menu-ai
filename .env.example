# Gemini API key — https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=

# RapidAPI key for Real-time Image Search — https://rapidapi.com/
# Optional: dish images fall back to a placeholder when absent
RAPIDAPI_KEY=

# Redis connection string for cross-instance rate limiting.
# Optional in single-process deployments (a per-process in-memory limiter is
# used as fallback). Required on Vercel / multi-container deploys, otherwise
# each instance keeps its own counter and the limit becomes per-instance.
# Local Docker Compose sets this automatically to the bundled redis service.
REDIS_URL=
