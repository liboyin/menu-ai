{
    "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22",
    "remoteUser": "node",
    "forwardPorts": [3000],
    "portsAttributes": {
        "3000": {
            "label": "Next.js dev server"
        }
    },
    "postCreateCommand": "npm install",
    "mounts": [
        "source=${localEnv:HOME}/.gitconfig,target=/home/node/.gitconfig,type=bind,readonly=true",
        "source=${localEnv:HOME}/.ssh,target=/home/node/.ssh,type=bind,readonly=true"
    ],
    "customizations": {
        "vscode": {
            "extensions": [
                "anthropic.claude-code",
                "dbaeumer.vscode-eslint",
                "mhutchie.git-graph",
                "ms-vscode.live-server",
                "openai.chatgpt",
                "orta.vscode-jest",
                "ryu1kn.partial-diff",
                "streetsidesoftware.code-spell-checker",
                "yzhang.markdown-all-in-one"
            ]
        }
    }
}
